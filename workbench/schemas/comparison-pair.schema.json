{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/comparison-pair.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pair_digest", "repository_identity", "base_snapshot_id", "candidate_snapshot_id", "diff"],
  "properties": {
    "schema_version": {"const": "sentinel-workbench-comparison-pair/v1"},
    "pair_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "base_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "modified", "deleted", "renamed"],
      "properties": {
        "added": {"type": "array", "items": {"type": "string"}},
        "modified": {"type": "array", "items": {"type": "string"}},
        "deleted": {"type": "array", "items": {"type": "string"}},
        "renamed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
          }
        }
      }
    }
  }
}
