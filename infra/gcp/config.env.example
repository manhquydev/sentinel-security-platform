# Sentinel — GCP Compute Engine deploy configuration (NO SECRETS HERE).
#
# Copy to infra/gcp/config.env (gitignored) and fill in. This file only holds
# non-secret deploy coordinates. Application secrets stay in infra/.env and are
# transferred to the VM out-of-band by `deploy.sh sync` — never through git.
#
#   cp infra/gcp/config.env.example infra/gcp/config.env
#   $EDITOR infra/gcp/config.env
#   bash infra/gcp/deploy.sh preflight

# --- Project / location -----------------------------------------------------
# The GCP project that owns the VM and (optionally) the Vertex AI endpoint.
PROJECT_ID=
# Zone decides the region for the VM. Pick one close to you and to VERTEXAI_LOCATION.
ZONE=asia-southeast1-b
REGION=asia-southeast1

# --- VM shape ---------------------------------------------------------------
# The full Charter topology (Juice Shop + Kong + LiteLLM + Langfuse + DefectDojo
# app + DefectDojo Postgres + ClickHouse + MinIO + Redis) is memory-heavy.
# e2-standard-4 (4 vCPU / 16 GB) is the practical floor; bump to e2-standard-8
# if DefectDojo/Langfuse first-boot migrations get OOM-killed.
VM_NAME=sentinel-charter
MACHINE_TYPE=e2-standard-4
BOOT_DISK_SIZE=60GB
BOOT_DISK_TYPE=pd-balanced
IMAGE_FAMILY=ubuntu-2404-lts-amd64
IMAGE_PROJECT=ubuntu-os-cloud
NETWORK_TAG=sentinel

# --- Service account --------------------------------------------------------
# The VM reaches Vertex AI via a mounted ADC file (VERTEXAI_ADC_PATH in
# infra/.env), NOT the VM's attached service account. So the SAFE DEFAULT is NO
# service account: leave BOTH blank and provision attaches --no-service-account
# --no-scopes. This prevents the deliberately-vulnerable Juice Shop container
# from minting a project-wide token via the metadata server (SSRF blast radius).
# Only set these if some VM-side agent genuinely needs a token, and then use a
# DEDICATED least-privilege SA (e.g. roles/logging.logWriter) — never the default
# compute SA with cloud-platform.
SERVICE_ACCOUNT_EMAIL=
SERVICE_ACCOUNT_SCOPES=

# --- SSH / access -----------------------------------------------------------
# Access model. "iap" (recommended) gives the VM NO inbound rule except IAP TCP
# forwarding for SSH (source 35.235.240.0/20); every app port stays loopback-only
# and is reached through an IAP tunnel. "operator-cidr" instead opens tcp:22 to a
# single trusted CIDR (set OPERATOR_SSH_CIDR). Never open app ports publicly.
ACCESS_MODEL=iap
OPERATOR_SSH_CIDR=

# --- Repo sync --------------------------------------------------------------
# Where the repo is placed on the VM. deploy.sh sync rsyncs the working tree here
# (excluding .git/.venv/heavy local state) plus infra/.env and DefectDojo certs.
REMOTE_REPO_DIR=/opt/sentinel/vinsoc
REMOTE_USER=

# --- Vertex AI (must match infra/.env) --------------------------------------
# Informational mirror of infra/.env keys so preflight can warn on obvious drift.
VERTEXAI_LOCATION=us-central1
