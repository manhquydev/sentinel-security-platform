                                "contextRegion": {
                                    "startLine": 6,
                                    "endLine": 12,
                                    "snippet": {
                                        "text": "    public ResultSet lookupUser(Connection conn, String username) throws Exception {\n        Statement stmt = conn.createStatement();\n        // Deliberately vulnerable: untrusted input concatenated directly into SQL.\n        String query = \"SELECT * FROM users WHERE username = '\" + username + \"'\";\n        return stmt.executeQuery(query);\n    }\n}"
                                    }
                                }
                            }
                        }
                    ],
                    "partialFingerprints": {
                        "primaryLocationLineHash": "b9e8cfa0cb30b92632d93c86ba52a609a6a68120ea85a5a5ebd42e9ebcf3dfbd",
                        "metisAnchor/v1": "250703d9cbdf20f5889de58f177c18ff967124e06c95ab5355a222bac0c5d5f6"
                    },
                    "properties": {
                        "cwe": "CWE-89",
                        "severity": "Critical",
                        "reasoning": "The `username` parameter is directly concatenated into a SQL query string without any sanitization, parameterization, or escaping. An attacker can control the `username` value (e.g., from an HTTP request) and inject arbitrary SQL commands, leading to data exfiltration, modification, or deletion. The comment on line 8 explicitly acknowledges this is deliberately vulnerable.",
                        "mitigation": "Use a parameterized query (PreparedStatement) instead of string concatenation. For example: PreparedStatement stmt = conn.prepareStatement(\"SELECT * FROM users WHERE username = ?\"); stmt.setString(1, username); return stmt.executeQuery();",
                        "confidence": 1.0,
                        "anchor": {
