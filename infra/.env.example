# Shared secrets for both DefectDojo stacks (app + external DB).
#
# Copy to infra/.env and fill in. infra/.env is gitignored and must never be
# committed. One file rather than one per stack: the database password is used by
# both, and duplicating a credential across two files is how they drift.
#
# Usage:
#   cp infra/.env.example infra/.env
#   scripts/dd-gen-keys.sh          # prints ready-to-paste key material
#   docker compose --env-file ../.env -f infra/defectdojo-db/docker-compose.yml up -d
#
# Deduplication config is NOT here - it is committed in
# infra/defectdojo/docker-compose.yml because it is reviewable policy, not a secret.

# ---------------------------------------------------------------------------
# Crypto keys - generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
# Both are refused at container boot by scripts/dd-boot-guard.sh if empty, unset,
# shorter than 16 chars, or equal to a value published in the DefectDojo repo.
# DD_CREDENTIAL_AES_256_KEY encrypts stored tool credentials at rest: losing it
# makes every stored credential unrecoverable, and rotating it without escrowing
# the old version makes older database dumps unreadable.
DD_SECRET_KEY=
DD_CREDENTIAL_AES_256_KEY=

# ---------------------------------------------------------------------------
# External database (infra/defectdojo-db)
# ---------------------------------------------------------------------------
# Reachable as dd-postgres:5432 inside the dd-net network, and 127.0.0.1:55433
# from the host. The TLS certificate is issued for exactly those two names.
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
# Generate with: openssl rand -base64 24
DD_DATABASE_PASSWORD=
# Seconds the app waits for the DB before giving up. Higher than upstream's 30
# because the TLS handshake plus first-boot migrations are slower than a plain
# local connection.
DD_DATABASE_READINESS_TIMEOUT=60

# ---------------------------------------------------------------------------
# Django admin (created once by the initializer service)
# ---------------------------------------------------------------------------
# Interactive/admin use only. CI must NOT use this account - dd-bootstrap.sh
# issues a separate non-superuser Writer token scoped to one Product.
DD_ADMIN_USER=admin
# Generate with: openssl rand -base64 24
DD_ADMIN_PASSWORD=
DD_ADMIN_MAIL=admin@defectdojo.local
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=User

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
DD_ALLOWED_HOSTS=localhost,127.0.0.1
DD_SITE_URL=http://localhost:8080
# Only needed when DefectDojo is reached through a reverse proxy / Cloudflare
# Tunnel hostname (e.g. a public gated demo). Django 4 requires the proxied
# HTTPS origin here for login POSTs, and that hostname must also be in
# DD_ALLOWED_HOSTS with DD_SITE_URL set to it. Leave empty for loopback-only.
# Example: DD_CSRF_TRUSTED_ORIGINS=https://app.example.com
DD_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Data model seeded by scripts/dd-bootstrap.sh
# ---------------------------------------------------------------------------
DD_PRODUCT_TYPE=VinSOC
DD_PRODUCT=juice-shop-harness
DD_ENGAGEMENT=week1-baseline
# Non-superuser service account that CI authenticates as.
DD_SERVICE_ACCOUNT_USER=ci-importer
# Generate with: openssl rand -base64 24
DD_SERVICE_ACCOUNT_PASSWORD=

# --- Shared LLM gateway (infra/litellm) ---
# Admin key. Mints virtual keys via /key/generate; never used by a client.
LITELLM_MASTER_KEY=
# The gateway's own key store, bundled in infra/litellm and reachable only over that
# stack's compose network. Credentials are discrete so the password never rides inside a
# DSN. The database name is fixed to `litellm`.
LITELLM_DB_USER=
LITELLM_DB_PASSWORD=
# The cx/* router. ROUTER_API_BASE ends in /v1. Only public corpora may be sent here —
# the router publishes no retention or training terms.
ROUTER_API_BASE=
ROUTER_API_KEY=
# Backs the frozen cheap-sast alias; needed only to re-score that arm.
DEEPSEEK_API_KEY=
# V2 judge variant, unset until that phase picks a model.
JUDGE_MODEL=
JUDGE_API_KEY=
# Embeddings. Unused against the router, which exposes no embedding model.
EMBED_MODEL=
EMBED_API_KEY=
EMBED_API_BASE=

# Vertex AI charter-analysis alias. These values route LiteLLM; the credential file
# itself remains outside the repository and is mounted into the container read-only.
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1
VERTEXAI_ADC_PATH=

# --- Langfuse tracing stack (infra/langfuse) ---
# Bundled stores. None publishes a port; only the web UI does, on loopback.
LANGFUSE_DB_USER=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_USER=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=
# openssl rand -hex 32 for each.
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
# Headless initialization. The project and its key pair are provisioned on first boot
# rather than through a browser signup, so the stack is reproducible and the gateway
# callback can be configured without a human clicking through the UI.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# Optional; the UI is published on 3001 because 3000 is already bound on this host.
LANGFUSE_NEXTAUTH_URL=
LANGFUSE_TELEMETRY_ENABLED=

# --- Week-2 Kong app-ingress gateway (infra/kong) ---------------------------
# The gateway database credential. Discrete vars, never a DSN.
KONG_DB_USER=
KONG_DB_PASSWORD=
# OAuth2 provision key for the client-credentials token endpoint. openssl rand -hex 32.
KONG_PROVISION_KEY=
# Per-agent OAuth2 client secrets. Each agent authenticates with client_id (fixed in
# the declarative policy) + this secret to mint a scoped, 5-minute bearer token.
# openssl rand -hex 32 for each.
AGENT_RECON_SECRET=
PROBE_ADMIN_SECRET=
# OAuth2 client secret for the local operator consumer sentinel-charter-executor
# (charter-read + write-basket). Held only by the executor adapter's context, never
# by an agent or the controller. openssl rand -hex 32.
SENTINEL_CHARTER_EXECUTOR_SECRET=
# Dedicated Key Auth credential for the same executor. It is sent only as the
# X-Sentinel-API-Key request credential, stripped by Kong before upstream/audit.
SENTINEL_CHARTER_EXECUTOR_API_KEY=

# --- Week-3 Threat-Intel RAG store (infra/rag-store) -------------------------
# Dedicated pgvector Postgres for the RAG corpus. Discrete vars, never a DSN.
RAG_DB_USER=
RAG_DB_PASSWORD=
# Optional loopback host port. Defaults to 55434; set a different value for an
# isolated local compose project.
RAG_DB_PORT=55434
