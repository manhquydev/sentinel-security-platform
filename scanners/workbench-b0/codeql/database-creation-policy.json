{
  "schema_version": "sentinel-workbench-codeql-database-creation-policy/v1",
  "command": [
    "codeql",
    "database",
    "create",
    "--db-cluster",
    "--language=javascript-typescript,actions",
    "--source-root=/src",
    "--",
    "/work/database-cluster"
