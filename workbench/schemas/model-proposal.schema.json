{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/model-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "attempt_id", "selection_manifest_digest", "proposal_ids", "response_digest", "terminal_state"],
  "properties": {
    "schema_version": {"const": "sentinel-workbench-model-proposal/v1"},
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "selection_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "proposal_ids": {"type": "array", "items": {"type": "string"}},
    "response_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_state": {"enum": ["succeeded", "failed", "unknown"]}
  }
}
