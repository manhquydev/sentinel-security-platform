# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
dist/
bin/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*
logs.txt
test-ck
__pycache__
.pytest_cache

# CK meta commands
prompt.md
ck.md

# Generated runtime layout for release/install smoke tests
/.claude/
# But track repo-level rules that Claude Code reads
!/.claude/rules/

# Local-only state inside tracked claude source
claude/agent-memory/
claude/hooks/.logs/
claude/session-state/latest.md
claude/session-state/archive/
claude/settings.bak.json
claude/skills/ai-multimodal/assets/demo-*.claude/session-state/*.tmp

# Gemini CLI settings (symlink to staged .claude/.mcp.json)
.gemini/settings.json
# Showoff/marketing assets (images, showcases)
assets/
# Exception: use-mcp ships a persistent tool catalog at assets/tools.json
!claude/skills/use-mcp/assets/
!claude/skills/use-mcp/assets/**

# External repos for study/reference
external/

# Git worktrees (local development only)
worktrees/

# AI-SAST benchmark: run artifacts, logs, DBs, cloned targets/tools, and
# generated virtual-key tmp files must never be committed (secrets + volume).
runs/
# benchmark/results/ holds Metis usage summaries and preflight canary artifacts.
# They embed the host username and absolute filesystem layout via codebase_path,
# and the canary SARIF carries verbatim scanned source in region.snippet.text.
benchmark/results/
benchmark/**/*.db
benchmark/**/*.sqlite
benchmark/**/*.log
benchmark/.*.key.tmp
benchmark/targets/
benchmark/tools/

# Harness core maintenance binary
scripts/bin/harness
scripts/bin/harness.exe

# phase-03 scanner artifacts (raw reports are secret-bearing until redacted)
scanners/out/
*.san.json
/tmp/scan-*

# Week-2 Kong gateway: TLS material and the rendered (secret-bearing) declarative
# policy are generated locally and must never be committed. The template is tracked.
infra/kong/kong.rendered.yml

# Week-3 RAG: local venv and any downloaded model cache are not committed
rag/.venv/
rag/.cache/

# Week-4 agent local virtualenv and generated maps are not committed
agent/.venv/
agent/out/

# Week-plus AI-SAST: RealVuln corpus is fetched at eval time (Apache-2.0), never committed (decision 0018/0019 pattern)
evaluation/sast-fp-discrimination/corpus/

# Runtime probe evidence can contain identity-bearing response bodies once probes authenticate.
# Commit redacted summaries/decisions instead of raw artefacts (red-team B2).
evaluation/absence-detection/*-probe-*.json
evaluation/absence-detection/defence-in-depth-map-*.json
evaluation/absence-detection/exposure-gap-*.json
.sentinel-runs/

# Personal / academic materials (VinUni × VinSOC internship) — local only, never push.
# Full charters, weekly student reports, and presentation scripts stay on disk
# but are not part of the public project contract. Use product/* and as-built
# docs as the published authority.
docs/Project_Sentinel_VinUni_x_VinSOC_12-week.md
docs/Project_Sentinel_6-week.md
docs/*_NguyenManhQuy_*.md
docs/*-kich-ban-trinh-bay.md
