# Shared secrets for both DefectDojo stacks (app + external DB).
#
# Copy to infra/.env and fill in. infra/.env is gitignored and must never be
# committed. One file rather than one per stack: the database password is used by
# both, and duplicating a credential across two files is how they drift.
#
# Usage:
#   cp infra/.env.example infra/.env
#   scripts/dd-gen-keys.sh          # prints ready-to-paste key material
#   docker compose --env-file ../.env -f infra/defectdojo-db/docker-compose.yml up -d
#
# Deduplication config is NOT here - it is committed in
# infra/defectdojo/docker-compose.yml because it is reviewable policy, not a secret.

# ---------------------------------------------------------------------------
# Crypto keys - generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
# Both are refused at container boot by scripts/dd-boot-guard.sh if empty, unset,
# shorter than 16 chars, or equal to a value published in the DefectDojo repo.
# DD_CREDENTIAL_AES_256_KEY encrypts stored tool credentials at rest: losing it
# makes every stored credential unrecoverable, and rotating it without escrowing
# the old version makes older database dumps unreadable.
DD_SECRET_KEY=
DD_CREDENTIAL_AES_256_KEY=

# ---------------------------------------------------------------------------
# External database (infra/defectdojo-db)
# ---------------------------------------------------------------------------
# Reachable as dd-postgres:5432 inside the dd-net network, and 127.0.0.1:55433
# from the host. The TLS certificate is issued for exactly those two names.
DD_DATABASE_NAME=defectdojo
DD_DATABASE_USER=defectdojo
# Generate with: openssl rand -base64 24
DD_DATABASE_PASSWORD=
# Seconds the app waits for the DB before giving up. Higher than upstream's 30
# because the TLS handshake plus first-boot migrations are slower than a plain
# local connection.
DD_DATABASE_READINESS_TIMEOUT=60

# ---------------------------------------------------------------------------
# Django admin (created once by the initializer service)
# ---------------------------------------------------------------------------
# Interactive/admin use only. CI must NOT use this account - dd-bootstrap.sh
# issues a separate non-superuser Writer token scoped to one Product.
DD_ADMIN_USER=admin
# Generate with: openssl rand -base64 24
DD_ADMIN_PASSWORD=
DD_ADMIN_MAIL=admin@defectdojo.local
DD_ADMIN_FIRST_NAME=Admin
DD_ADMIN_LAST_NAME=User

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
DD_ALLOWED_HOSTS=localhost,127.0.0.1
DD_SITE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Data model seeded by scripts/dd-bootstrap.sh
# ---------------------------------------------------------------------------
DD_PRODUCT_TYPE=VinSOC
DD_PRODUCT=juice-shop-harness
DD_ENGAGEMENT=week1-baseline
# Non-superuser service account that CI authenticates as.
DD_SERVICE_ACCOUNT_USER=ci-importer
# Generate with: openssl rand -base64 24
DD_SERVICE_ACCOUNT_PASSWORD=

# --- Shared LLM gateway (infra/litellm) ---
# Admin key. Mints virtual keys via /key/generate; never used by a client.
LITELLM_MASTER_KEY=
# Where virtual keys and spend persist. Loopback Postgres, supplied rather than bundled:
# it holds the keys that reproduce the frozen benchmark arms.
LITELLM_DATABASE_URL=
# The cx/* router. ROUTER_API_BASE ends in /v1. Only public corpora may be sent here —
# the router publishes no retention or training terms.
ROUTER_API_BASE=
ROUTER_API_KEY=
# Backs the frozen cheap-sast alias; needed only to re-score that arm.
DEEPSEEK_API_KEY=
# V2 judge variant, unset until that phase picks a model.
JUDGE_MODEL=
JUDGE_API_KEY=
# Embeddings. Unused against the router, which exposes no embedding model.
EMBED_MODEL=
EMBED_API_KEY=
EMBED_API_BASE=
