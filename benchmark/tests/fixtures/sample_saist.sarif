{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "informationUri": "https://github.com/DataDog/datadog-saist",
          "name": "datadog-ai-static-analyzer",
          "version": "1.0.1",
          "rules": [
            {
              "id": "datadog/java-sqli",
              "shortDescription": { "text": "Potential SQL injection" },
              "fullDescription": { "text": "In Java, SQL Injection (CWE-89) occurs when untrusted input is concatenated directly into SQL statements." },
              "properties": {
                "tags": [
                  "DATADOG_RULE_TYPE:datadog-ai-static-analyzer",
                  "CWE:89",
                  "SEVERITY:WARNING",
                  "CATEGORY:SECURITY"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "_fixture_note": "Rule metadata above (id, tags, CWE:89 location) is copied verbatim from a real SAIST run (runs/spike-saist-output.sarif, 2026-07-21). The result below is CONSTRUCTED, not a real finding: SAIST produced 0 real results this round because DeepSeek rejected its json_schema response_format (see runs/spike-engine-endpoint.md). It follows SAIST's real result schema shape (ruleId/level/message/locations/physicalLocation/region) so the converter has a genuine SAIST-style CWE-in-rule-tags case to handle, pending a real SAIST result once it runs against a compatible provider (e.g. Gemini).",
          "ruleId": "datadog/java-sqli",
          "level": "warning",
          "message": { "text": "Potential SQL injection via string concatenation of untrusted input" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "VulnSample.java" },
                "region": { "startLine": 9, "endLine": 10 }
              }
            }
          ]
        }
      ]
    }
  ]
}
