# Copy to benchmark/.env, fill in real values, NEVER commit the filled file.
# .env is gitignored at repo root; benchmark/*.env is additionally covered below.

# --- LiteLLM proxy ---
LITELLM_MASTER_KEY=
# Optional: only if you want persistent virtual-key/spend tracking across restarts.
# LITELLM_DATABASE_URL=

# --- router aliases (sast-sol, sast-terra, sast-gpt55): models under test ---
# The clawcmc agent router, openai-compatible. ROUTER_API_BASE ends in /v1.
# Models must be from the cx/* family: it is the only one that implements /v1/responses,
# which is the endpoint Metis calls. See runs/spike-router-endpoint.md.
# The router injects a large system prompt into every request and reports its own
# model name rather than the backing one — see the gateway_prompt_caveat on scorecards.
# Only public corpora (OWASP Benchmark, WebGoat) may be sent here: the router publishes
# no retention or training terms. Private code requires a terms review first.
ROUTER_API_BASE=
ROUTER_API_KEY=

# --- cheap-sast alias: FROZEN DeepSeek comparison arm (V0 runs 1-2) ---
# Needed only to re-score or reproduce that arm; no new run uses it.
DEEPSEEK_API_KEY=

# --- judge alias (V2 stretch variant only) ---
JUDGE_MODEL=
JUDGE_API_KEY=

# --- embed alias (Metis indexing) ---
# UNUSED this round: the router exposes no embedding model, so indexing stays off.
# These are NOT router credentials despite having been used as such during the spike —
# router credentials are ROUTER_API_* above.
EMBED_MODEL=
EMBED_API_KEY=
EMBED_API_BASE=

# --- SAIST (discovered blocker, see runs/spike-engine-endpoint.md) ---
# SAIST fetches its detection/validation prompts from a Datadog-hosted API and
# requires a Datadog account even when scanning locally. Confirm with user before spike.
DD_API_KEY=
DD_APP_KEY=

# Per-tool virtual keys (generated by scripts/generate-virtual-key.sh, NOT the master key).
# Fill in after running the script once LiteLLM is up.
SAIST_VIRTUAL_KEY=
METIS_VIRTUAL_KEY=

# Per-tier, per-run benchmark keys. The model dimension is part of the name because
# two tiers at the same run number sharing one key destroys per-arm attribution — which
# is the only accounting left once LiteLLM's pricing-based spend goes inert for router models.
V0_SOL_RUN1_VIRTUAL_KEY=
V0_SOL_RUN2_VIRTUAL_KEY=
V0_SOL_RUN3_VIRTUAL_KEY=
V0_TERRA_RUN1_VIRTUAL_KEY=
V0_TERRA_RUN2_VIRTUAL_KEY=
V0_TERRA_RUN3_VIRTUAL_KEY=
V0_GPT55_RUN1_VIRTUAL_KEY=
V0_GPT55_RUN2_VIRTUAL_KEY=
V0_GPT55_RUN3_VIRTUAL_KEY=
