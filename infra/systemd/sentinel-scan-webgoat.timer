# Schedule for the WebGoat half of the baseline writer (see
# sentinel-scan-webgoat.service). sentinel-scan.timer schedules the Juice Shop
# half independently; both share scan-and-import.sh's flock, so an overlap
# between the two is serialised rather than raced.
#
# Daily, with a randomised delay so it does not fire at a predictable instant, and
# Persistent so a firing missed while the machine was off runs on next boot rather
# than being skipped. Adjust OnCalendar to the cadence you want; whatever it is,
# it defines what "fresh" means for verify-lake.sh's MAX_IMPORT_AGE_SECONDS.

[Unit]
Description=Schedule the Sentinel WebGoat scan into the DefectDojo lake

# These are --user units. Without lingering, the user manager exits at logout and the
# timer never fires unattended; Persistent=true only catches up at the next login, which
# on an operator's laptop can be a long time. Enable it once:
#   loginctl enable-linger $USER
[Timer]
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
