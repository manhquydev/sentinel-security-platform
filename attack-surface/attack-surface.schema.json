{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "target", "coverage", "endpoints", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "target": {
      "type": "object",
      "required": ["name", "version", "image_digest", "source_commit", "source_revision_label"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_revision_label": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["mode", "limitations"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["anonymous-locator-only"]},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "method", "path", "evidence_source", "source_ref", "source_sha256",
          "observed_at", "auth_class", "state_change", "confidence", "rationale",
          "parameters", "finding_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "path": {"type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,=:@%/-]*$"},
          "evidence_source": {"enum": ["pinned-source", "pinned-openapi", "sanitized-nuclei"]},
          "source_ref": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "observed_at": {"type": "string", "format": "date-time"},
          "auth_class": {"enum": ["public", "authenticated", "administrative", "unknown", "hypothesis"]},
          "state_change": {"enum": ["read-only", "state-changing", "unknown", "hypothesis"]},
          "confidence": {"enum": ["observed", "high", "medium", "low", "hypothesis"]},
          "rationale": {"type": "string", "minLength": 1},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
                "type": {"enum": ["string", "integer", "number", "boolean", "array", "object", "unknown"]}
              }
            }
          },
          "finding_refs": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}}
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "evidence_source", "source_ref", "source_sha256", "observed_at", "confidence", "rationale"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "evidence_source": {"enum": ["pinned-source", "pinned-openapi", "sanitized-nuclei", "trivy-digest"]},
          "source_ref": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "observed_at": {"type": "string", "format": "date-time"},
          "confidence": {"enum": ["observed", "high", "medium", "low", "hypothesis"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
