{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel Workbench Broker Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "status"],
  "properties": {
    "schema_version": {"const": "sentinel-workbench-broker-status/v1"},
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "diagnostic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
